/* Professional Dark Theme for MultiSEM Control */

QMainWindow {
    background-color: #1e1e1e;
    color: #ffffff;
}

QWidget {
    background-color: #1e1e1e;
    color: #e0e0e0;
    font-family: "Segoe UI", "Helvetica Neue", Arial, sans-serif;
    font-size: 13px;
}

/* Groups and Panels */
QGroupBox {
    border: 1px solid #3e3e3e;
    border-radius: 4px;
    margin-top: 1em;
    padding-top: 10px;
    font-weight: bold;
    color: #569cd6; /* VS Code Blue */
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 3px;
}

/* Buttons */
QPushButton {
    background-color: #3c3c3c;
    border: 1px solid #3e3e3e;
    border-radius: 3px;
    padding: 6px 12px;
    color: #ffffff;
}

QPushButton:hover {
    background-color: #505050;
}

QPushButton:pressed {
    background-color: #007acc; /* Active Blue */
    border-color: #007acc;
}

QPushButton:disabled {
    background-color: #2d2d2d;
    color: #666666;
    border-color: #2d2d2d;
}

/* Text Inputs */
QLineEdit, QSpinBox, QDoubleSpinBox {
    background-color: #252526;
    border: 1px solid #3e3e3e;
    border-radius: 2px;
    padding: 4px;
    color: #cccccc;
}

QLineEdit:focus {
    border: 1px solid #007acc;
}

/* Log View */
QTextEdit {
    background-color: #1e1e1e;
    border: 1px solid #3e3e3e;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 12px;
}

/* Status Bar */
QStatusBar {
    background-color: #007acc;
    color: white;
}

/* Labels */
QLabel {
    color: #cccccc;
}

QLabel#StatusValue {
    font-weight: bold;
    color: #4ec9b0; /* Greenish */
}

QLabel#ErrorValue {
    font-weight: bold;
    color: #f44747; /* Red */
}

